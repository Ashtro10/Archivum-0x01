# Minimal self-hosted LiveKit server for Clu (free, open source: https://github.com/livekit/livekit).
# Generate your own keys:  livekit-server generate-keys   (never use example/dev keys outside a test)
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  # On a home network / phone hotspot keep this false; for an internet-facing server set true (or node_ip).
  use_external_ip: false
keys:
  REPLACE_WITH_API_KEY: REPLACE_WITH_API_SECRET_AT_LEAST_32_CHARS
logging:
  level: info
