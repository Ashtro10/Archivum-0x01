<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.clu">

    <!-- Local network sync between phone and tablet, optional internet tools and downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Voice input; requested only when the microphone is first used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- LiveKit mode only: communication audio mode (echo cancellation) and loudspeaker routing during a session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Background wake-word listening (visible notification). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Proactive messages and download completion. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Owner verification with the device's screen lock / fingerprint (BiometricManager, BiometricPrompt). Normal permission. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Alarms and timers through the clock app. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Package visibility (Android 11+): find launchable apps and handlers for maps/dial/browser/calendar. -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="geo" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="google.navigation" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.intent.action.INSERT" /><data android:mimeType="vnd.android.cursor.dir/event" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".CluApp"
        android:label="Clu"
        android:icon="@drawable/ic_clu"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".ui.MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.VoiceChatActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.ConnectionActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ConversationsActivity" />
        <activity android:name=".ui.MemoryActivity" />
        <activity android:name=".ui.MemoryEditActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ProposalsActivity" />
        <activity android:name=".ui.TimelineActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ArchivePeopleActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.PersonEditActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.DocumentsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.DocumentActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ProjectsActivity" />
        <activity android:name=".ui.ProjectEditActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ArchiveImportActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ConflictsActivity" />
        <activity android:name=".ui.DiaryActivity" />
        <activity android:name=".ui.DiaryEditActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.SettingsActivity" />
        <activity android:name=".ui.SettingsCategoryActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.WakeWordsActivity" />
        <activity android:name=".ui.ModelsActivity" />
        <activity android:name=".ui.VoiceActivity" />
        <activity android:name=".ui.CharactersActivity" />
        <activity android:name=".ui.CharacterEditActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.PeopleActivity" />
        <activity android:name=".ui.CommandsActivity" />
        <activity android:name=".ui.DevicesActivity" />
        <activity android:name=".ui.PreferencesActivity" />
        <activity android:name=".ui.ToolHistoryActivity" />
        <activity android:name=".ui.DiagnosticsActivity" />
        <activity android:name=".ui.SpeechDiagnosticsActivity" />
        <activity android:name=".CrashReportActivity" />

        <service android:name=".voice.ListeningService" android:exported="false" android:foregroundServiceType="microphone" />
        <receiver android:name=".proactive.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="ai.clu.REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".tools.CluNotificationListener" android:exported="true" android:label="CLU"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <service android:name=".proactive.ProactiveJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
