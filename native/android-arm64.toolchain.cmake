# Cross-compiles for Android arm64 with the host's clang and the Bionic sysroot fetched by
# scripts/setup_toolchain.sh (see that script for provenance).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CLU_ANDROID ON)
set(ANDROID ON)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CLU_SYSROOT "${_root}/toolchain/ndk/sysroot")
set(CLU_RESDIR "${CMAKE_BINARY_DIR}/clang-resource")
execute_process(COMMAND clang -print-resource-dir OUTPUT_VARIABLE _host_res OUTPUT_STRIP_TRAILING_WHITESPACE)
file(MAKE_DIRECTORY "${CLU_RESDIR}")
file(CREATE_LINK "${_host_res}/include" "${CLU_RESDIR}/include" SYMBOLIC)
file(CREATE_LINK "${_root}/toolchain/ndk/clang-rt-lib" "${CLU_RESDIR}/lib" SYMBOLIC)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-android31)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-android31)
set(CMAKE_SYSROOT "${CLU_SYSROOT}")
# armv8.2-a + dotprod + fp16: supported by Snapdragon 870 (Cortex-A77/A55) and Snapdragon 8 Gen 2.
set(_flags "-resource-dir ${CLU_RESDIR} -march=armv8.2-a+dotprod+fp16 -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_flags}")
set(_ld "-fuse-ld=lld -rtlib=compiler-rt --unwindlib=libunwind -resource-dir ${CLU_RESDIR}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_ld}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_ld}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
